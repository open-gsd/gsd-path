# GSD Path — optional test and live-evidence environment variables
#
# Copy to .env and export values before opt-in tiers (dogfood, host evaluation, UI).
# The default CI/local gate (`npm run verify` / `make verify`) needs no .env file.
#
#   cp .env.example .env
#   set -a && source .env && set +a
#
# See TEST_ENVIRONMENT.md for tier descriptions and troubleshooting.

# -----------------------------------------------------------------------------
# Default offline gate (npm run verify) — no secrets required
# -----------------------------------------------------------------------------
# Prerequisites only: Node >= 18.17, Python >= 3.9, git on PATH.
# Optional: run `make install` (npm ci) once per checkout.

# -----------------------------------------------------------------------------
# Installer / host home overrides (tests mock these; set only for manual installs)
# -----------------------------------------------------------------------------
# CODEX_HOME=~/.codex
# COPILOT_HOME=~/.copilot

# -----------------------------------------------------------------------------
# Strict host-registry checks (tests/test_host_registry.py)
# When set to any non-empty value, live-verified host CLIs must be on PATH.
# -----------------------------------------------------------------------------
# GSD_LIVE_HOSTS=1

# -----------------------------------------------------------------------------
# Live dogfood smoke (tests/dogfood.py, .github/workflows/dogfood.yml)
# Requires the host CLI installed and authenticated.
# -----------------------------------------------------------------------------
# GSD_E2E_HOST=claude
# ANTHROPIC_API_KEY=sk-ant-...        # claude dogfood / Claude host runner
# OPENAI_API_KEY=sk-...               # codex dogfood / Codex host runner

# -----------------------------------------------------------------------------
# Release host evaluation (tests/evaluate_host.py, tests/evaluate_features.py)
# Explicit opt-in; never run in CI verify.
# -----------------------------------------------------------------------------
# GSD_CODEX_MODEL=gpt-6-astra
# GSD_CODEX_REASONING=high
# GSD_OPENCODE_MODEL=provider/model
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openrouter/anthropic/claude-sonnet-5
# ZED_EVAL_CLI=/path/to/eval-cli
# ZED_EVAL_MODEL=openrouter/anthropic/claude-sonnet-5
# ZED_EVAL_UNSANDBOXED=1

# -----------------------------------------------------------------------------
# Daemon tests and manual daemon runs (daemon/README.md)
# -----------------------------------------------------------------------------
# GSD_DAEMON_CONFIG=/path/to/daemon-config.json
# GSD_DAEMON_HISTORY=/path/to/daemon-history.jsonl
# GSD_DAEMON_PLATFORM=darwin|linux|win32   # preview another platform's install steps

# -----------------------------------------------------------------------------
# Daemon dashboard UI acceptance (tests/test_daemon_board_ui.py)
# Requires Orca embedded browser; skipped unless set.
# -----------------------------------------------------------------------------
# GSD_UI_TEST=1

# -----------------------------------------------------------------------------
# Bootstrap repository tests — internal fakes (tests/test_bootstrap_repository.py)
# Do not set unless you are extending those tests.
# -----------------------------------------------------------------------------
# FAKE_GH_ROOT=/tmp/fake-github-remotes
# FAKE_GH_DEFAULT_BRANCH=main
# FAKE_GH_FAIL_CLONE=1

# -----------------------------------------------------------------------------
# Dispatch driver fakes (tests/test_dispatch_driver.py) — internal only
# -----------------------------------------------------------------------------
# FAKE_MODE=ready
# FAKE_REVIEW=pass
# FAKE_SKEPTIC=stands
