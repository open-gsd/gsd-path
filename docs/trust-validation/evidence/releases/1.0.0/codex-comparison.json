            "from pathlib import Path; Path('test_count.py').write_text(\"import json\\nfrom pathlib import Path\\nimport subprocess\\nimport sys\\nimport unittest\\n\\n\\nSCRIPT = Path(__file__).resolve().with_name(\\\"count.py\\\")\\n\\n\\nclass WidgetCounterTests(unittest.TestCase):\\n    def run_cli(self, *args):\\n        return subprocess.run(\\n            [sys.executable, str(SCRIPT), *args],\\n            capture_output=True,\\n            text=True,\\n        )\\n\\n    def test_plain_text(self):\\n        for args, count in [((), 0), ((\\\"0\\\",), 0), ((\\\"3\\\",), 3), ((\\\"-7\\\",), -7)]:\\n            with self.subTest(args=args):\\n                result = self.run_cli(*args)\\n                self.assertEqual(result.returncode, 0, result.stderr)\\n                self.assertEqual(result.stdout, f\\\"{count} widgets\\\\n\\\")\\n                self.assertEqual(result.stderr, \\\"\\\")\\n\\n    def test_json(self):\\n        cases = [\\n            ((\\\"--json\\\",), 0),\\n            ((\\\"--json\\\", \\\"0\\\"), 0),\\n            ((\\\"--json\\\", \\\"3\\\"), 3),\\n            ((\\\"3\\\", \\\"--json\\\"), 3),\\n            ((\\\"--json\\\", \\\"-7\\\"), -7),\\n            ((\\\"-7\\\", \\\"--json\\\"), -7),\\n        ]\\n        for args, count in cases:\\n            with self.subTest(args=args):\\n                result = self.run_cli(*args)\\n                self.assertEqual(result.returncode, 0, result.stderr)\\n                value = json.loads(result.stdout)\\n                self.assertEqual(value, {\\\"widgets\\\": count})\\n                self.assertIs(type(value[\\\"widgets\\\"]), int)\\n                self.assertEqual(result.stderr, \\\"\\\")\\n\\n    def test_invalid_input(self):\\n        cases = [\\n            ((\\\"abc\\\",), \\\"abc\\\"),\\n            ((\\\"1.5\\\",), \\\"1.5\\\"),\\n            ((\\\"--json\\\", \\\"abc\\\"), \\\"abc\\\"),\\n            ((\\\"abc\\\", \\\"--json\\\"), \\\"abc\\\"),\\n            ((\\\"1\\\", \\\"2\\\"), \\\"2\\\"),\\n            ((\\\"--json\\\", \\\"1\\\", \\\"2\\\"), \\\"2\\\"),\\n            ((\\\"--unknown\\\",), \\\"--unknown\\\"),\\n        ]\\n        for args, invalid in cases:\\n            with self.subTest(args=args):\\n                result = self.run_cli(*args)\\n                self.assertNotEqual(result.returncode, 0)\\n                self.assertEqual(result.stdout, \\\"\\\")\\n                self.assertIn(\\\"error\\\", result.stderr.lower())\\n                self.assertIn(invalid, result.stderr)\\n                self.assertNotIn(\\\"Traceback\\\", result.stderr)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    unittest.main()\\n\")"
