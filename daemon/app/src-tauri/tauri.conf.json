{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenGSD Path",
  "version": "0.1.3",
  "identifier": "org.gsd-path.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../pyproject.toml": "daemon/pyproject.toml",
      "../../README.md": "daemon/README.md",
      "../../gsd_daemon/*.py": "daemon/gsd_daemon/"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzQzA2MjU1NjQ3RTRERDAKUldUUVRYNWtWV0xBczAzTlBROFIvMHdHWlc5aXlJblc5bFFnclB4UEtZM3hOc0ZOeTBrT0huY28K",
      "endpoints": [
        "https://github.com/open-gsd/gsd-path/releases/download/app-latest/latest.json"
      ]
    }
  }
}
